# Django
DJANGO_SETTINGS_MODULE=config.settings
DJANGO_SECRET_KEY=troque-por-uma-chave-secreta-forte
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Banco de dados (Supabase) --------------------------------------------
# App em runtime: Transaction Pooler (porta 6543).
DATABASE_URL=postgresql://postgres.SEU_REF:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# Migrations: conexão direta (porta 5432). Se der timeout no IPv4, troque
# pela Session Pooler (host do pooler, porta 5432, user postgres.SEU_REF).
DATABASE_DIRECT_URL=postgresql://postgres:SUA_SENHA@db.SEU_REF.supabase.co:5432/postgres
# Ligue quando o app falar com o Supabase via pooler.
DJANGO_DB_POOLER=True
# DJANGO_DB_DIRECT é ligado só ao rodar migrations (ver README).

# --- Storage (Supabase Storage, S3-compatível) ----------------------------
DJANGO_USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=divulgacao
AWS_S3_ENDPOINT_URL=https://SEU_REF.supabase.co/storage/v1/s3
AWS_S3_REGION_NAME=sa-east-1

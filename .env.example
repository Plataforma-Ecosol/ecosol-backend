# Django
DJANGO_SETTINGS_MODULE=config.settings
DJANGO_SECRET_KEY=troque-por-uma-chave-secreta-forte
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Banco de dados (Supabase) --------------------------------------------
# App em runtime: Transaction Pooler (porta 6543).
DATABASE_URL=postgresql://postgres.SEU_REF:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# Migrations: conexão direta (porta 5432). Se der timeout no IPv4, troque
# pela Session Pooler (host do pooler, porta 5432, user postgres.SEU_REF).
DATABASE_DIRECT_URL=postgresql://postgres:SUA_SENHA@db.SEU_REF.supabase.co:5432/postgres
# Ligue quando o app falar com o Supabase via pooler.
DJANGO_DB_POOLER=True
# DJANGO_DB_DIRECT é ligado só ao rodar migrations (ver README).

# --- Storage (Supabase Storage, S3-compatível) ----------------------------
DJANGO_USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=divulgacao
AWS_S3_ENDPOINT_URL=https://SEU_REF.supabase.co/storage/v1/s3
AWS_S3_REGION_NAME=sa-east-1

# --- Deploy (homologação / produção) --------------------------------------
# Ligue onde houver proxy HTTPS na frente (Render). Nunca no local.
DJANGO_ATRAS_DE_PROXY_HTTPS=False
# Origens do login do Admin, com esquema, separadas por vírgula. O site (Next)
# também abre o Admin, repassando `/admin/` ao Django (decisão 8.6), então o
# endereço dele precisa estar aqui. No local, só o Next da máquina; esta é a
# única das três variáveis de deploy que se liga no local.
# Homologação: https://ecosol-backend-homolog.onrender.com,https://ecosol-frontend.vercel.app
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
# Cookies só por HTTPS. True em homologação e produção.
DJANGO_COOKIES_SEGUROS=False

# --- Área administrativa --------------------------------------------------
# URL do site público (Next), para o link "Ver site público" e o item
# "Relatório" do menu do Admin. Sem a variável, vale o mesmo Next local.
# Homologação: https://ecosol-frontend.vercel.app
DJANGO_URL_SITE_PUBLICO=http://localhost:3000
